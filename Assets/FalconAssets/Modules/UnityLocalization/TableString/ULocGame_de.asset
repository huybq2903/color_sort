  m_TableData:
  - m_Id: 28579642907283456
    m_Localized: "Tippen, um Gegenst\xE4nde zu entnehmen"
    m_Metadata:
      m_Items: []
  - m_Id: 28579642932449280
    m_Localized: Ziehen Sie das Objekt an eine Stelle und lassen Sie los, um es zu
      platzieren!
    m_Metadata:
      m_Items: []
  - m_Id: 28579642932449281
    m_Localized: Super! Noch einmal!
    m_Metadata:
      m_Items: []
  - m_Id: 41905690210545664
    m_Localized: Spielen
    m_Metadata:
      m_Items: []
  - m_Id: 41905690407677952
    m_Localized: "Demn\xE4chst"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690407677953
    m_Localized: "Erhalte eine zus\xE4tzliche Box"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690407677954
    m_Localized: Automatisch 3 Pfeile verbinden!
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872256
    m_Localized: "Erhalte einen zus\xE4tzlichen Pfosten"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872257
    m_Localized: Bewege 3 Pfeile heraus, um Felder zu leeren
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872258
    m_Localized: "W\xE4hle einen beliebigen Pfeil, auch blockierte!"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872259
    m_Localized: Kein Platz mehr
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872260
    m_Localized: Kostenlos
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872261
    m_Localized: Fortfahren
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872262
    m_Localized: Neustart
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872263
    m_Localized: Ein neuer Anfang!
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872264
    m_Localized: 1 Leben verlieren und neu starten
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872265
    m_Localized: Sind Sie sicher?
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872266
    m_Localized: Du wirst verlieren
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872267
    m_Localized: Verlassen
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872268
    m_Localized: Aufgeben
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872269
    m_Localized: Gold
    m_Metadata:
      m_Items: []
  - m_Id: 41933045452845056
    m_Localized: Leben voll
    m_Metadata:
      m_Items: []
  - m_Id: 41959956468019200
    m_Localized: Keine Werbung
    m_Metadata:
      m_Items: []
  - m_Id: 41959956472213504
    m_Localized: Level {0} freischalten
    m_Metadata:
      m_Items: []
  - m_Id: 41962382986129408
    m_Localized: "Kein weiterer Warteslot hinzuf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 41962382990323712
    m_Localized: Kein Pfosten in der Warteschlange
    m_Metadata:
      m_Items: []
  - m_Id: 41969681318359040
    m_Localized: Booster verwenden
    m_Metadata:
      m_Items: []
  - m_Id: 43700320564490240
    m_Localized: Dunkel/Hell Modus
    m_Metadata:
      m_Items: []
  - m_Id: 44098253080309760
    m_Localized: "Gedr\xFCckt halten, um das Brett zu sehen"
    m_Metadata:
      m_Items: []
  - m_Id: 44099563536068608
    m_Localized: Stufe
    m_Metadata:
      m_Items: []
  - m_Id: 44099563536068609
    m_Localized: Gut gemacht
    m_Metadata:
      m_Items: []
  - m_Id: 44180751697129472
    m_Localized: Level nicht geschafft
    m_Metadata:
      m_Items: []
  - m_Id: 44180751701323776
    m_Localized: Level-Fortschritt
    m_Metadata:
      m_Items: []
  - m_Id: 46361195147673600
    m_Localized: Tippe auf einen Pfeil, um zu entwirren
    m_Metadata:
      m_Items: []
  - m_Id: 46697132947914752
    m_Localized: Tippen, um neu zu zentrieren
    m_Metadata:
      m_Items: []
  - m_Id: 47091438249390080
    m_Localized: Noch nicht freigeschaltet
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361600
    m_Localized: "Der Name ist ung\xFCltig."
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361601
    m_Localized: Standardname kann nicht verwendet werden
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361602
    m_Localized: Bitte warten
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361603
    m_Localized: "Kann keine weiteren Boxen \xF6ffnen"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361604
    m_Localized: Der Besen ist aktiviert
    m_Metadata:
      m_Items: []
  - m_Id: 47091438274555904
    m_Localized: Warten, bis das Garn sich setzt
    m_Metadata:
      m_Items: []
  - m_Id: 47091438274555905
    m_Localized: Der Magnet ist aktiviert
    m_Metadata:
      m_Items: []
  - m_Id: 47091438274555906
    m_Localized: Die erste Box ist voll
    m_Metadata:
      m_Items: []
  - m_Id: 47110991089221632
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164672
    m_Localized: Name
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164673
    m_Localized: Geben Sie Ihren Namen ein
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164674
    m_Localized: Schreiben Sie etwas (140 Zeichen)
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164675
    m_Localized: Speichern
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164676
    m_Localized: Avatar
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164677
    m_Localized: Rahmen
    m_Metadata:
      m_Items: []
  - m_Id: 47112087031496704
    m_Localized: "Namen \xE4ndern"
    m_Metadata:
      m_Items: []
  - m_Id: 49543409326866432
    m_Localized: Bitte verbinden Sie sich mit dem Netzwerk oder WLAN, um das Spiel
      fortzusetzen.
    m_Metadata:
      m_Items: []
  - m_Id: 49544770844082176
    m_Localized: Kein Internet
    m_Metadata:
      m_Items: []
  - m_Id: 50664297887678464
    m_Localized: "Schlie\xDFe Level ab, um Gold zu deinem Sparschwein hinzuzuf\xFCgen"
    m_Metadata:
      m_Items: []
  - m_Id: 50664297887678465
    m_Localized: Wert
    m_Metadata:
      m_Items: []
  - m_Id: 50664297887678466
    m_Localized: "Zur\xFCcksetzen in:"
    m_Metadata:
      m_Items: []
  - m_Id: 50672779894439936
    m_Localized: Beginne zu sammeln!
    m_Metadata:
      m_Items: []
  - m_Id: 51020162120364032
    m_Localized: "Verf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 50664297854124032
    m_Localized: Sparschwein
    m_Metadata:
      m_Items: []
  - m_Id: 55748375917871104
    m_Localized: "Pi\xF1ata-Party"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814144
    m_Localized: "Schlie\xDFe Level ab, um {0} S\xFC\xDFigkeiten zu sammeln,\\n um
      die n\xE4chste Pi\xF1ata zu zerbrechen"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814145
    m_Localized: "Gl\xFCckwunsch!!! \\nDu kannst das Geschenk jetzt nehmen!"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814146
    m_Localized: Das Event ist beendet! \nDu kannst das Geschenk trotzdem noch erhalten!
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814147
    m_Localized: Das Ereignis ist beendet!
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814148
    m_Localized: Abschluss
    m_Metadata:
      m_Items: []
  - m_Id: 57187055311073280
    m_Localized: "F\xFClle die Box mit \\n<color=#FF1616> 3 Pfeilen derselben Farbe!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850496
    m_Localized: Beanspruchen
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850497
    m_Localized: Aktiviert
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850498
    m_Localized: Aktiv
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850499
    m_Localized: Bonusbank
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850500
    m_Localized: Aktiviere den {0}, um die Bonusbank am Ende der Level freizuschalten!
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850501
    m_Localized: Pfeildurchgang
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850502
    m_Localized: Das Aktivieren des {0} gibt Ihnen die Chance, spezielle Belohnungen
      zu erhalten.
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850503
    m_Localized: '{0} Leben statt {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850504
    m_Localized: "Du erh\xE4ltst exklusive Boni, bis das Ereignis endet."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850505
    m_Localized: "{0} hat begonnen! \nSammle den Schl\xFCssel, um die Spezialbelohnung
      freizuschalten"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850506
    m_Localized: '{0} ist beendet! \nNeuer Arrow Pass beginnt bald!'
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850507
    m_Localized: "Level abschlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850508
    m_Localized: "Schl\xFCssel sammeln"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850509
    m_Localized: Belohnungen einfordern
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850510
    m_Localized: Tippen zum Fortfahren
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850511
    m_Localized: "Sammle mehr Schl\xFCssel, um freizuschalten"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850512
    m_Localized: Premium-Belohnung ist nicht aktiv
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850513
    m_Localized: "Diese Belohnung wurde bereits eingel\xF6st"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850514
    m_Localized: Klicken, um diese Belohnung zu beanspruchen
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850515
    m_Localized: Hier sind deine nicht beanspruchten Belohnungen
    m_Metadata:
      m_Items: []
  - m_Id: 57193728230633472
    m_Localized: Durch Aktivieren des Pfeilpasses erhalten Sie die Chance auf spezielle
      Belohnungen.
    m_Metadata:
      m_Items: []
  - m_Id: 57225919274405888
    m_Localized: Weg blockiert! Entferne den Pfeil davor.
    m_Metadata:
      m_Items: []
  - m_Id: 58574076018671616
    m_Localized: Vollendet
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003264
    m_Localized: Katzenturm
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003265
    m_Localized: Gewinnserie-Level zum Aufsteigen!
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003266
    m_Localized: Du hast die Spitze erreicht!
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003267
    m_Localized: Verbleibende Zeit
    m_Metadata:
      m_Items: []
  - m_Id: 58697177665097728
    m_Localized: Kombiniere 3 Pfeile derselben Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 58993758662545408
    m_Localized: Nur 1 Platz frei! Verwende einen Booster!
    m_Metadata:
      m_Items: []
  - m_Id: 59400713805746176
    m_Localized: "Nur 1 Slot \xFCbrig! Verwende Zusatzbox!"
    m_Metadata:
      m_Items: []
  - m_Id: 59718114195968000
    m_Localized: Passe die Pfeilfarbe an die Box an
    m_Metadata:
      m_Items: []
  - m_Id: 59782361707167744
    m_Localized: Gewinnserie erreichen und die Katze nach oben springen lassen!
    m_Metadata:
      m_Items: []
  - m_Id: 69552235722215424
    m_Localized: "Ziehen Sie zuerst die \xE4u\xDFere Schicht, um das Garngewirr zu
      l\xF6sen!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575552
    m_Localized: "Entferne den blockierenden Pfeil, um die Farbe des Verborgenen
      Pfeils zu enth\xFCllen."
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575553
    m_Localized: "Ziehe die Pfeile mit Schl\xFCsseln, um die anderen zu befreien!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575554
    m_Localized: "Ziehe beliebige Pfeile, um die gesperrte Zone zu \xF6ffnen!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575555
    m_Localized: Ziehe beliebige Pfeile, um die Eisbox zu zerbrechen!
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575556
    m_Localized: Ziehe beliebige Pfeile, um die Wollkiste nacheinander zu zerbrechen!
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575557
    m_Localized: Ziehe beliebige Pfeile, um den Eis-Pfeil zu brechen!
    m_Metadata:
      m_Items: []
  - m_Id: 71376246412136448
    m_Localized: "Ziehe Pfeile, um zu entsperren und zu enth\xFCllen, was darunter
      liegt."
    m_Metadata:
      m_Items: []
  - m_Id: 73878725737918464
    m_Localized: Pool-Sprung
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889984
    m_Localized: Starte die Herausforderung mit {0} Spielern
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889985
    m_Localized: "Gehe zu den n\xE4chsten Stufen f\xFCr gr\xF6\xDFere Preise"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889986
    m_Localized: Wenn du ein Level nicht schaffst, scheiterst du an der Herausforderung.
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889987
    m_Localized: Spieler
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889988
    m_Localized: "Schlie\xDFe {0} Level ab, um die Herausforderung zu meistern"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889989
    m_Localized: Du hast die Herausforderung nicht bestanden
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889990
    m_Localized: "Herzlichen Gl\xFCckwunsch! Du hast die Herausforderung abgeschlossen."
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889991
    m_Localized: Stufe
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889992
    m_Localized: Du wirst in {0} eliminiert
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889993
    m_Localized: Spieler auf deinem Niveau finden
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889994
    m_Localized: Hauptpreis
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889995
    m_Localized: Du hast die Herausforderung gewonnen
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889996
    m_Localized: Teile die Belohnungen mit {0} Spielern
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889997
    m_Localized: "Herzlichen Gl\xFCckwunsch"
    m_Metadata:
      m_Items: []
  - m_Id: 75954948454559744
    m_Localized: Kombiniere \n<color=#FF1616> 3 Pfeile derselben Farbe!</color>
    m_Metadata:
      m_Items: []
  - m_Id: 75954948475531264
    m_Localized: Kombiniere 3 Pfeile derselben Farbe
    m_Metadata:
      m_Items: []
  - m_Id: 79257081229344768
    m_Localized: Kombiniere 3 Pfeile derselben Farbe, um sie zu entfernen.
    m_Metadata:
      m_Items: []
  - m_Id: 81126741595205632
    m_Localized: "Nur noch 1 Platz! \xDCberlege deinen n\xE4chsten Zug gut."
    m_Metadata:
      m_Items: []
  - m_Id: 81522732613840896
    m_Localized: Bringe alle Pfeile in Einklang, um zu gewinnen!
    m_Metadata:
      m_Items: []
  - m_Id: 81835551062306816
    m_Localized: "Leere 3 Pl\xE4tze, um weiterzuspielen!"
    m_Metadata:
      m_Items: []
