    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 1e5eed70a79a01a408ed3388c0c382af, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 28579642907283456
    m_Localized: "Dokunarak e\u015Fyalar\u0131 \xE7\u0131kar"
    m_Metadata:
      m_Items: []
  - m_Id: 28579642932449280
    m_Localized: "\xD6\u011Feyi bir yere s\xFCr\xFCkleyin ve b\u0131rak\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 28579642932449281
    m_Localized: Harika! Bir Kez Daha!
    m_Metadata:
      m_Items: []
  - m_Id: 41905690210545664
    m_Localized: Oyna
    m_Metadata:
      m_Items: []
  - m_Id: 41905690407677952
    m_Localized: "\xC7ok Yak\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690407677953
    m_Localized: Ekstra Kutu Al
    m_Metadata:
      m_Items: []
  - m_Id: 41905690407677954
    m_Localized: "Otomatik olarak 3 oku e\u015Fle\u015Ftir!"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872256
    m_Localized: Ekstra Direk Al
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872257
    m_Localized: "3 oku d\u0131\u015Far\u0131 ta\u015F\u0131yarak yuvalar\u0131 temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872258
    m_Localized: "Herhangi bir oku se\xE7, engellenmi\u015F olanlar bile!"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872259
    m_Localized: "Uzay D\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872260
    m_Localized: "\xDCcretsiz"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872261
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872262
    m_Localized: "Yeniden Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872263
    m_Localized: "Yeni bir ba\u015Flang\u0131\xE7!"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872264
    m_Localized: "1 Can Kaybet ve Yeniden Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872265
    m_Localized: Emin misiniz?
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872266
    m_Localized: Kaybedeceksiniz
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872267
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872268
    m_Localized: "Vazge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 41905690411872269
    m_Localized: "Alt\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 41933045452845056
    m_Localized: Canlar dolu
    m_Metadata:
      m_Items: []
  - m_Id: 41959956468019200
    m_Localized: "Reklams\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 41959956472213504
    m_Localized: "Seviye {0} Kilidini A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 41962382986129408
    m_Localized: "Bir bekleme yuvas\u0131 daha eklenemez"
    m_Metadata:
      m_Items: []
  - m_Id: 41962382990323712
    m_Localized: "Bekleme \xE7ubu\u011Funda direk yok"
    m_Metadata:
      m_Items: []
  - m_Id: 41969681318359040
    m_Localized: "G\xFC\xE7lendirici kullan"
    m_Metadata:
      m_Items: []
  - m_Id: 43700320564490240
    m_Localized: "Karanl\u0131k/Ayd\u0131nl\u0131k Mod"
    m_Metadata:
      m_Items: []
  - m_Id: 44098253080309760
    m_Localized: "Tahtay\u0131 g\xF6rmek i\xE7in bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 44099563536068608
    m_Localized: Seviye
    m_Metadata:
      m_Items: []
  - m_Id: 44099563536068609
    m_Localized: Aferin
    m_Metadata:
      m_Items: []
  - m_Id: 44180751697129472
    m_Localized: "Seviye Ba\u015Far\u0131s\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 44180751701323776
    m_Localized: "Seviye \u0130lerlemesi"
    m_Metadata:
      m_Items: []
  - m_Id: 46361195147673600
    m_Localized: "Bir oku \xE7\xF6zmek i\xE7in dokunun"
    m_Metadata:
      m_Items: []
  - m_Id: 46697132947914752
    m_Localized: Merkezi yeniden ayarla
    m_Metadata:
      m_Items: []
  - m_Id: 47091438249390080
    m_Localized: "Hen\xFCz Kilidi A\xE7\u0131lmad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361600
    m_Localized: "\u0130sim ge\xE7erli de\u011Fil"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361601
    m_Localized: "Varsay\u0131lan ad kullan\u0131lamaz"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361602
    m_Localized: "L\xFCtfen bekleyin"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361603
    m_Localized: "Daha fazla kutu a\xE7\u0131lam\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361604
    m_Localized: "S\xFCp\xFCrge etkinle\u015Ftirildi"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438274555904
    m_Localized: "\u0130pin yerle\u015Fmesini bekliyor"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438274555905
    m_Localized: "M\u0131knat\u0131s etkinle\u015Ftirildi"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438274555906
    m_Localized: "\u0130lk kutu dolu"
    m_Metadata:
      m_Items: []
  - m_Id: 47110991089221632
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164672
    m_Localized: "\u0130sim"
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164673
    m_Localized: "Ad\u0131n\u0131z\u0131 girin"
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164674
    m_Localized: "Bir \u015Feyler yaz (140 karakter)"
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164675
    m_Localized: Kaydetmek
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164676
    m_Localized: Avatar
    m_Metadata:
      m_Items: []
  - m_Id: 47110991131164677
    m_Localized: "\xC7er\xE7eve"
    m_Metadata:
      m_Items: []
  - m_Id: 47112087031496704
    m_Localized: "\u0130smi De\u011Fi\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 49543409326866432
    m_Localized: "L\xFCtfen oyuna devam etmek i\xE7in a\u011Fa veya Wi-Fi'ye ba\u011Flan\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 49544770844082176
    m_Localized: "\u0130nternet yok"
    m_Metadata:
      m_Items: []
  - m_Id: 50664297887678464
    m_Localized: "Seviyeleri tamamlayarak Kumbaran\u0131za Alt\u0131n ekleyin"
    m_Metadata:
      m_Items: []
  - m_Id: 50664297887678465
    m_Localized: "De\u011Fer"
    m_Metadata:
      m_Items: []
  - m_Id: 50664297887678466
    m_Localized: "S\u0131f\u0131rlanacak:"
    m_Metadata:
      m_Items: []
  - m_Id: 50672779894439936
    m_Localized: "Biriktirmeye ba\u015Fla!"
    m_Metadata:
      m_Items: []
  - m_Id: 51020162120364032
    m_Localized: Mevcut
    m_Metadata:
      m_Items: []
  - m_Id: 50664297854124032
    m_Localized: Kumbara
    m_Metadata:
      m_Items: []
  - m_Id: 55748375917871104
    m_Localized: Pinata Partisi
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814144
    m_Localized: "Sonraki Pinata'y\u0131 k\u0131rmak i\xE7in\\n {0} \u015Feker toplayarak
      seviyeleri ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814145
    m_Localized: "Tebrikler!!! \\nHediyeyi \u015Fimdi alabilirsin!"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814146
    m_Localized: "Etkinlik sona erdi! \\nH\xE2l\xE2 hediyeyi alabilirsiniz!"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814147
    m_Localized: Etkinlik sona erdi!
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814148
    m_Localized: Bitiriliyor
    m_Metadata:
      m_Items: []
  - m_Id: 57187055311073280
    m_Localized: "Ayn\u0131 renkteki \\n<color=#FF1616>3 okla kutuyu doldur!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850496
    m_Localized: Talep Et
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850497
    m_Localized: "Etkinle\u015Ftirildi"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850498
    m_Localized: Aktif
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850499
    m_Localized: "Bonus Bankas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850500
    m_Localized: "{0}'y\u0131 etkinle\u015Ftirerek a\u015Famalar\u0131n sonunda Bonus
      Bankas\u0131n\u0131 a\xE7\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850501
    m_Localized: "Ok Ustas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850502
    m_Localized: "{0}'yi etkinle\u015Ftirmek, \xF6zel \xF6d\xFCller kazanma \u015Fans\u0131
      verir."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850503
    m_Localized: '{1} yerine {0} can'
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850504
    m_Localized: "Etkinlik sona erene kadar \xF6zel bonusunuz olacak."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850505
    m_Localized: "{0} ba\u015Flad\u0131! \n\xD6zel \xD6d\xFCl\xFC a\xE7mak i\xE7in
      anahtar\u0131 topla"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850506
    m_Localized: "{0} sona erdi! \\nYeni Arrow Pass yak\u0131nda ba\u015Flayacak!"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850507
    m_Localized: "Seviyeyi Ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850508
    m_Localized: "Anahtar\u0131 Topla"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850509
    m_Localized: "\xD6d\xFClleri Al"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850510
    m_Localized: "Devam etmek i\xE7in dokunun"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850511
    m_Localized: "Daha fazla anahtar topla a\xE7mak i\xE7in"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850512
    m_Localized: "Premium \xF6d\xFCl etkin de\u011Fil"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850513
    m_Localized: "Bu \xF6d\xFCl zaten al\u0131nd\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850514
    m_Localized: "\xD6d\xFCl\xFC almak i\xE7in t\u0131klay\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850515
    m_Localized: "\u0130\u015Fte al\u0131nmam\u0131\u015F \xF6d\xFClleriniz"
    m_Metadata:
      m_Items: []
  - m_Id: 57193728230633472
    m_Localized: "Ok Yay\u0131'n\u0131 Etkinle\u015Ftir, \xF6zel \xF6d\xFCller kazanma
      \u015Fans\u0131 verecek"
    m_Metadata:
      m_Items: []
  - m_Id: 57225919274405888
    m_Localized: "Yol kapal\u0131! \xD6n\xFCn\xFCzdeki oku kald\u0131r\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 58574076018671616
    m_Localized: "Tamamlanm\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003264
    m_Localized: Kedi Kulesi
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003265
    m_Localized: "Kazan\xE7 serisi seviyesini atla!"
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003266
    m_Localized: "Zirveye ula\u015Ft\u0131n\u0131z!"
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003267
    m_Localized: "Kalan s\xFCre"
    m_Metadata:
      m_Items: []
  - m_Id: 58697177665097728
    m_Localized: "Ayn\u0131 renkte 3 oku e\u015Fle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 58993758662545408
    m_Localized: "Sadece 1 slot kald\u0131! Bir g\xFC\xE7lendirici kullan!"
    m_Metadata:
      m_Items: []
  - m_Id: 59400713805746176
    m_Localized: "Sadece 1 slot kald\u0131! Kutu ekle!"
    m_Metadata:
      m_Items: []
  - m_Id: 59718114195968000
    m_Localized: "Oku rengini kutuyla e\u015Fle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 59782361707167744
    m_Localized: "Kazan\xE7 serilerini tamamla ve kediyi zirveye z\u0131plat!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235722215424
    m_Localized: "\xD6nce d\u0131\u015F katman\u0131 \xE7ekin, \u0130plik D\xFC\u011F\xFCm\xFCn\xFC
      \xE7\xF6z\xFCn!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575552
    m_Localized: "Engellenen oku kald\u0131rarak Gizli Okun rengini ortaya \xE7\u0131kar\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575553
    m_Localized: "Anahtarlarla Oklar\u0131 \xC7ekerek Kilitli Di\u011Ferini Serbest
      B\u0131rak!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575554
    m_Localized: "Herhangi bir Oku \xE7ekerek Kilitli Alan\u0131 k\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575555
    m_Localized: "Herhangi bir Oku \xE7ekerek Buz Kutusunu k\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575556
    m_Localized: "Her bir Ok'u \xE7ekerek Th\xF9ng G\xF6z\xFCn\xFC birer birer k\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 69552235751575557
    m_Localized: "Herhangi bir Oku \xE7ekerek Buz Okunu k\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 71376246412136448
    m_Localized: "Herhangi bir oku \xE7ekerek kilidi a\xE7 ve alt\u0131ndaki \u015Feyi
      ortaya \xE7\u0131kar."
    m_Metadata:
      m_Items: []
  - m_Id: 73878725737918464
    m_Localized: Havuz Atlama
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889984
    m_Localized: "{0} oyuncu ile meydan okumay\u0131 ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889985
    m_Localized: "Daha b\xFCy\xFCk \xF6d\xFCller i\xE7in sonraki a\u015Famalara ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889986
    m_Localized: "Bir seviyede ba\u015Far\u0131s\u0131z olursan\u0131z, meydan okumay\u0131
      kaybedersiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889987
    m_Localized: Oyuncu
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889988
    m_Localized: "Meydan okumay\u0131 tamamlamak i\xE7in {0} seviyeyi ge\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889989
    m_Localized: "Meydan okumay\u0131 ba\u015Faramad\u0131n\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889990
    m_Localized: "Tebrikler! Meydan okumay\u0131 tamamlad\u0131n\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889991
    m_Localized: "A\u015Fama"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889992
    m_Localized: "{0} i\xE7inde eleneceksiniz"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889993
    m_Localized: "Seviyenizde oyuncular aran\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889994
    m_Localized: "B\xFCy\xFCk \xD6d\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889995
    m_Localized: "Meydan okumay\u0131 kazand\u0131n\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889996
    m_Localized: "\xD6d\xFClleri {0} oyuncuyla payla\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 73878725758889997
    m_Localized: Tebrikler
    m_Metadata:
      m_Items: []
  - m_Id: 75954948454559744
    m_Localized: "Ayn\u0131 renkteki \\n<color=#FF1616>3 oku e\u015Fle\u015Ftir!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 75954948475531264
    m_Localized: "Ayn\u0131 renkte 3 oku e\u015Fle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 79257081229344768
    m_Localized: "Ayn\u0131 renkteki 3 oku e\u015Fle\u015Ftirerek temizle"
    m_Metadata:
      m_Items: []
  - m_Id: 81126741595205632
    m_Localized: "Sadece 1 slot kald\u0131! Bir sonraki hamleni dikkatli yap."
    m_Metadata:
      m_Items: []
  - m_Id: 81522732613840896
    m_Localized: "T\xFCm oklar\u0131 e\u015Fle\u015Ftir ve kazan!"
    m_Metadata:
      m_Items: []
  - m_Id: 81835551062306816
    m_Localized: "Oynamaya devam etmek i\xE7in 3 yuva bo\u015Falt\u0131n!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
