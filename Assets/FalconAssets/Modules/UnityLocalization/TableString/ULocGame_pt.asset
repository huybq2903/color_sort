    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361603
    m_Localized: "N\xE3o \xE9 poss\xEDvel abrir mais caixas"
    m_Metadata:
      m_Items: []
  - m_Id: 47091438270361604
    m_Localized: "A vassoura est\xE1 ativada"
