    m_Metadata:
      m_Items: []
  - m_Id: 58697177665097728
    m_Localized: "Associez 3 fl\xE8ches de la m\xEAme couleur"
    m_Metadata:
      m_Items: []
  - m_Id: 58993758662545408
    m_Localized: Il ne reste qu'un emplacement ! Utilisez un booster !
    m_Metadata:
      m_Items: []
  - m_Id: 59400713805746176
    m_Localized: "Il ne reste qu'un emplacement ! Utilisez la bo\xEEte d'ajout !"
