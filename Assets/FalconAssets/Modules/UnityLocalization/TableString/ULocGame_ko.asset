      m_Items: []
  - m_Id: 50664297887678464
    m_Localized: "\uB808\uBCA8\uC744 \uC644\uB8CC\uD558\uC5EC \uB3FC\uC9C0 \uC800\uAE08\uD1B5\uC5D0
