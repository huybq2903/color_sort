      m_Items: []
  - m_Id: 55748375917871104
    m_Localized: "\uD53C\uB0D0\uD0C0 \uD30C\uD2F0"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814144
    m_Localized: "\uB808\uBCA8\uC744 \uC644\uB8CC\uD558\uC5EC {0}\uAC1C\uC758 \uC0AC\uD0D5\uC744
      \uBAA8\uC544\\n\uB2E4\uC74C \uD53C\uB0D0\uD0C0\uB97C \uAE68\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814145
    m_Localized: "\uCD95\uD558\uD569\uB2C8\uB2E4!!! \\n\uC9C0\uAE08 \uC120\uBB3C\uC744
      \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814146
    m_Localized: "\uC774\uBCA4\uD2B8\uAC00 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4!
      \\n\uC120\uBB3C\uC744 \uC544\uC9C1 \uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814147
    m_Localized: "\uC774\uBCA4\uD2B8\uAC00 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 55748375959814148
    m_Localized: "\uC644\uB8CC"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055311073280
    m_Localized: "\uAC19\uC740 \uC0C9\uC0C1\uC758 <color=#FF1616>\uD654\uC0B4\uD45C
      3\uAC1C\uB85C \uC0C1\uC790\uB97C \uCC44\uC6B0\uC138\uC694!</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850496
    m_Localized: "\uBC1B\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850497
    m_Localized: "\uD65C\uC131\uD654\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850498
    m_Localized: "\uD65C\uC131\uD654\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850499
    m_Localized: "\uBCF4\uB108\uC2A4 \uC740\uD589"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850500
    m_Localized: "{0}\uC744(\uB97C) \uD65C\uC131\uD654\uD558\uC5EC \uC2A4\uD14C\uC774\uC9C0
      \uC885\uB8CC \uC2DC \uBCF4\uB108\uC2A4 \uC740\uD589\uC744 \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850501
    m_Localized: "\uD654\uC0B4 \uD1B5\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850502
    m_Localized: "{0}\uC744(\uB97C) \uD65C\uC131\uD654\uD558\uBA74 \uD2B9\uBCC4 \uBCF4\uC0C1\uC744
      \uBC1B\uC744 \uAE30\uD68C\uAC00 \uC8FC\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850503
    m_Localized: "{1} \uB300\uC2E0 {0} \uB77C\uC774\uBE0C"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850504
    m_Localized: "\uC774\uBCA4\uD2B8\uAC00 \uC885\uB8CC\uB420 \uB54C\uAE4C\uC9C0
      \uB3C5\uC810 \uBCF4\uB108\uC2A4\uB97C \uBC1B\uAC8C \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850505
    m_Localized: "{0} \uC2DC\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4!\n\uD2B9\uBCC4 \uBCF4\uC0C1\uC744
      \uC7A0\uAE08 \uD574\uC81C\uD558\uB824\uBA74 \uC5F4\uC1E0\uB97C \uBAA8\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850506
    m_Localized: "{0}\uC774(\uAC00) \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4! \\n\uC0C8\uB85C\uC6B4
      \uD654\uC0B4 \uD328\uC2A4\uAC00 \uACE7 \uC2DC\uC791\uB429\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850507
    m_Localized: "\uB808\uBCA8 \uD074\uB9AC\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850508
    m_Localized: "\uC5F4\uC1E0 \uC218\uC9D1"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850509
    m_Localized: "\uBCF4\uC0C1 \uBC1B\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850510
    m_Localized: "\uD0ED\uD558\uC5EC \uACC4\uC18D\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850511
    m_Localized: "\uB354 \uB9CE\uC740 \uC5F4\uC1E0\uB97C \uBAA8\uC544 \uC7A0\uAE08
      \uD574\uC81C\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850512
    m_Localized: "\uD504\uB9AC\uBBF8\uC5C4 \uBCF4\uC0C1\uC774 \uD65C\uC131\uD654\uB418\uC9C0
      \uC54A\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850513
    m_Localized: "\uC774 \uBCF4\uC0C1\uC740 \uC774\uBBF8 \uC218\uB839\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850514
    m_Localized: "\uBCF4\uC0C1\uC744 \uBC1B\uC73C\uB824\uBA74 \uD074\uB9AD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57187055327850515
    m_Localized: "\uC5EC\uAE30\uC5D0\uC11C \uC218\uB839\uD558\uC9C0 \uC54A\uC740
      \uBCF4\uC0C1\uC744 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57193728230633472
    m_Localized: "\uD654\uC0B4 \uD328\uC2A4\uB97C \uD65C\uC131\uD654\uD558\uBA74
      \uD2B9\uBCC4 \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uAE30\uD68C\uAC00 \uC8FC\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57225919274405888
    m_Localized: "\uAE38\uC774 \uB9C9\uD614\uC2B5\uB2C8\uB2E4! \uC55E\uC5D0 \uC788\uB294
      \uD654\uC0B4\uD45C\uB97C \uCE58\uC6CC\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 58574076018671616
    m_Localized: "\uC644\uC804\uD55C"
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003264
    m_Localized: "\uACE0\uC591\uC774 \uD0C0\uC6CC"
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003265
    m_Localized: "\uC5F0\uC2B9 \uB808\uBCA8\uC744 \uC62C\uB9AC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 58574076069003266
    m_Localized: "\uC815\uC0C1\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4!"
