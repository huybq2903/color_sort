    - Term: ads.remove_banner
      TermType: 0
      Description: 
      Languages:
      - Remove bottom banner ads
      - "X\xF3a qu\u1EA3ng c\xE1o bi\u1EC3u ng\u1EEF d\u01B0\u1EDBi c\xF9ng"
