    - Term: ads.remove_interstitial
      TermType: 0
      Description: 
      Languages:
      - Remove all interstitial ads
      - "X\xF3a m\u1ECDi qu\u1EA3ng c\xE1o xen k\u1EBD"
      - "\u79FB\u9664\u6240\u6709\u63D2\u9875\u5E7F\u544A"
      - "\u79FB\u9664\u6240\u6709\u63D2\u9801\u5EE3\u544A"
      - "\u30A4\u30F3\u30BF\u30FC\u30B9\u30C6\u30A3\u30B7\u30E3\u30EB\u5E83\u544A\u3092\u3059\u3079\u3066\u524A\u9664\u3059\u308B"
      - "\uBAA8\uB4E0 \uC804\uBA74 \uAD11\uACE0\uB97C \uC81C\uAC70\uD569\uB2C8\uB2E4"
      - "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0432\u0441\u0435 \u043C\u0435\u0436\u0441\u0442\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0435
        \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F"
