      - "\u79FB\u9664\u5E95\u90E8\u6A6B\u5E45\u5EE3\u544A"
      - "\u4E0B\u90E8\u30D0\u30CA\u30FC\u5E83\u544A\u3092\u524A\u9664\u3059\u308B"
      - "\uD558\uB2E8 \uBC30\uB108 \uAD11\uACE0\uB97C \uC81C\uAC70\uD569\uB2C8\uB2E4"
      - "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u043D\u0438\u0436\u043D\u0438\u0435
        \u0431\u0430\u043D\u043D\u0435\u0440\u043D\u044B\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F"
