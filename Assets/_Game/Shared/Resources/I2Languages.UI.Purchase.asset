    - Term: ui.purchase.purchase_cancelled
      TermType: 0
      Description: 
      Languages:
      - Purchase Cancelled!
      - "\u0110\xE3 H\u1EE7y Giao d\u1ECBch!"
      - "\u8D2D\u4E70\u5DF2\u53D6\u6D88\uFF01"
      - "\u8CFC\u8CB7\u53D6\u6D88\uFF01"
      - "\u8CFC\u5165\u3092\u30AD\u30E3\u30F3\u30BB\u30EB\u3057\u307E\u3057\u305F\uFF01"
      - "\uAD6C\uB9E4\uAC00 \uCDE8\uC18C\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
      - "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u041E\u0442\u043C\u0435\u043D\u0435\u043D\u0430!"
      - "Achat Annul\xE9 !"
      - Kauf Storniert!
      - Pembelian Dibatalkan!
      - Acquisto Annullato!
      - Compra Cancelada!
      - "\xA1Compra Cancelada!"
      - "Sat\u0131n Alma Iptal Edildi!"
      - "\u0E01\u0E32\u0E23\u0E0B\u0E37\u0E49\u0E2D\u0E16\u0E39\u0E01\u0E22\u0E01\u0E40\u0E25\u0E34\u0E01!"
      Flags: 000000000000000000000000000000
      Languages_Touch: []
    - Term: ui.purchse.purchase_has_been_cancelled
      TermType: 0
      Description: 
      Languages:
      - Purchase has been cancelled!
      - "Giao d\u1ECBch mua \u0111\xE3 b\u1ECB h\u1EE7y!"
      - "\u8D2D\u4E70\u5DF2\u53D6\u6D88\uFF01"
      - "\u8CFC\u8CB7\u53D6\u6D88\uFF01"
      - "\u8CFC\u5165\u306F\u30AD\u30E3\u30F3\u30BB\u30EB\u3055\u308C\u307E\u3057\u305F!"
      - "\uAD6C\uB9E4\uAC00 \uCDE8\uC18C\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
      - "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u0430!"
      - "L'achat a \xE9t\xE9 annul\xE9 !"
      - Kauf wurde storniert!
      - Pembelian telah dibatalkan!
      - "L'acquisto \xE8 stato annullato!"
      - A compra foi cancelada!
      - "\xA1La compra ha sido cancelada!"
      - "Sat\u0131n alma i\u015Flemi iptal edildi!"
      - "\u0E01\u0E32\u0E23\u0E0B\u0E37\u0E49\u0E2D\u0E16\u0E39\u0E01\u0E22\u0E01\u0E40\u0E25\u0E34\u0E01\u0E41\u0E25\u0E49\u0E27!"
      Flags: 000000000000000000000000000000
      Languages_Touch: []
