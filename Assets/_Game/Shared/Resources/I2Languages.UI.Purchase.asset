    - Term: ui.purchase.purchase_successful
      TermType: 0
      Description: 
      Languages:
      - Purchase Successful!
      - "Giao d\u1ECBch Th\xE0nh C\xF4ng!"
      - "\u8D2D\u4E70\u6210\u529F\uFF01"
      - "\u8CFC\u8CB7\u6210\u529F\uFF01"
      - "\u8CFC\u5165\u6210\u529F\u3057\u307E\u3057\u305F\uFF01"
      - "\uAD6C\uB9E4 \uC131\uACF5!"
      - "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u0423\u0441\u043F\u0435\u0448\u043D\u0430!"
